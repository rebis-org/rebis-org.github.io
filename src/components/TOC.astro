---
import type { MarkdownHeading } from "astro";

interface Props {
	readonly headings: readonly MarkdownHeading[];
	readonly title: string;
}
const { headings, title } = Astro.props;
---

{
  headings.length > 0 && (
    <nav class="text-secondary mb-8 text-sm" aria-label={title}>
      <p class="text-primary mb-2 font-medium">{title}</p>
      <ol class="m-0 list-none space-y-1 p-0">
        {headings.map(({ depth, slug, text }) => (
          <li style={`padding-inline-start: ${(depth - 2) * 0.75}rem`}>
            <a class="interactive-link" href={`#${slug}`}>
              {text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
