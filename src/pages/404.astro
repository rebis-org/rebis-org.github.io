<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>404</title>
    <script>
      const base = import.meta.env.BASE_URL;
      const prefix = base.replace(/\/+$/, "");
      const pathname =
        prefix && location.pathname.startsWith(`${prefix}/`)
          ? location.pathname.slice(prefix.length)
          : location.pathname;
      const match = /^\/(en-us|zh-cn)(?:\/|$)/.exec(pathname);
      const languages = navigator.languages ?? [navigator.language];
      const locale =
        match?.[1] ??
        (languages.some((value) => /^zh-(cn|hans)(?:-|$)/i.test(value))
          ? "zh-cn"
          : "en-us");
      location.replace(`${base}${locale}/404/`);
    </script>
    <noscript>
      <meta
        http-equiv="refresh"
        content={`0; url=${import.meta.env.BASE_URL}en-us/404/`}
      />
    </noscript>
  </head>
</html>
