{
	"name": "rebis-org.github.io",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "astro build",
		"check": "astro check",
		"dev": "astro dev",
		"fmt": "biome format --write astro.config.ts package.json src .github",
		"fmt:check": "biome format astro.config.ts package.json src .github",
		"lint": "biome lint astro.config.ts src/*.ts src/*/*.ts src/*/*/*.ts",
		"quality": "biome check astro.config.ts src/*.ts src/*/*.ts src/*/*/*.ts",
		"preview": "astro preview"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.3.5",
		"@astrojs/mdx": "^7.0.5",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@shikijs/transformers": "^4.4.2",
		"@unocss/astro": "66.7.5",
		"@unocss/preset-typography": "66.7.5",
		"@unocss/preset-wind4": "66.7.5",
		"@unocss/transformer-variant-group": "66.7.5",
		"astro": "7.2.0",
		"katex": "^0.18.1",
		"lucide": "^1.29.0",
		"mermaid": "^11.16.1",
		"morphicons": "^1.4.2",
		"pangu": "9.1.0",
		"satteri": "^0.9.5"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@biomejs/biome": "2.5.7",
		"@types/node": "^26.1.2",
		"lightningcss": "^1.33.0",
		"typescript": "6.0.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "nub",
			"version": "^0.6.0",
			"onFail": "warn"
		}
	},
	"allowBuilds": {
		"esbuild": true,
		"lightningcss": true,
		"core-js": true
	},
	"patchedDependencies": {
		"@astrojs/markdown-satteri@0.3.5": "patches/@astrojs+markdown-satteri@0.3.5.patch"
	}
}
